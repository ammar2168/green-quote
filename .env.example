# Postgres container (docker-compose.yml reads these).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=green_quote
# Change if something already owns 5432 on the host.
POSTGRES_PORT=5432

# Host port for the app container (docker compose --profile app up).
APP_PORT=3000

# What the app and drizzle-kit connect with. Keep in sync with the values above.
# The app and migrate containers ignore it and use postgres:5432 instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/green_quote

# Signs the session cookie. Generate with: openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET=

# Server logs (lib/logger.ts). Level: debug | info | warn | error | silent.
# Format: json (default) or pretty (default under `next dev`).
LOG_LEVEL=info
# LOG_FORMAT=json

# Optional. The e2e suite (pnpm test:e2e) creates, migrates and drops its own
# database; it defaults to DATABASE_URL's database with _e2e appended. The name
# must end in _e2e or _test.
# E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/green_quote_e2e

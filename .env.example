# Postgres container (docker-compose.yml reads these).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=green_quote
# Change if something already owns 5432 on the host.
POSTGRES_PORT=5432

# What the app and drizzle-kit connect with. Keep in sync with the values above.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/green_quote
